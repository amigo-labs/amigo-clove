{"de":{"Home":[{"frame":false,"wav":"OceanTrouble2E_Bruce_surrounded.wav","ms":2125,"text":"Ich bin umgeben von stinkendem Müll."},{"frame":true,"wav":"OceanTrouble2E_homesweethome.wav","ms":1891,"text":"Home sweet home."}],"Door":[{"frame":true,"wav":"OceanTrouble2E_doors.wav","ms":7703,"text":"Die Tür versucht Widerstand zu leisten. Ich hab's... Mist, die nächste Tür hämmert wie verrückt und ich habe keinerlei Kontrolle über sie."}],"Cocoons":[{"frame":false,"wav":"OceanTrouble2E_Bruce_Cocoons.wav","ms":1656,"text":"Kokons."},{"frame":true,"wav":"OceanTrouble2E_Interesting.wav","ms":1500,"text":"Interessant..."},{"frame":false,"wav":"OceanTrouble2E_Bruce_slipping.wav","ms":1500,"text":"Sie schlüpfen!"}],"Invisible":[{"frame":false,"wav":"OceanTrouble2E_Bruce_Invisible.wav","ms":1891,"text":"Diese Viecher sind unsichtbar!"}],"Fish_Gen":[{"frame":true,"wav":"OceanTrouble2E_Flamethrowers.wav","ms":3234,"text":"Schau mal nach oben.. Flammenwerfer!"}],"Refuel":[{"frame":true,"wav":"OceanTrouble2E_Alaska.wav","ms":2750,"text":"Wir haben hier einen Notruf aus Alaska."},{"frame":false,"wav":"OceanTrouble2E_Bruce_refuel.wav","ms":2594,"text":"Alaska? Da muss ich erstmal volltanken."}]},"en":{"Home":[{"frame":false,"wav":"OceanTrouble2E_Bruce_surrounded.wav","ms":2125,"text":"I’m surrounded by dirt."},{"frame":true,"wav":"OceanTrouble2E_homesweethome.wav","ms":1891,"text":"Home sweet home."}],"Door":[{"frame":true,"wav":"OceanTrouble2E_doors.wav","ms":7703,"text":"That door tries to resist. Ah, opened. The next door is hammering and I don’t have any control about it. Be careful."}],"Cocoons":[{"frame":false,"wav":"OceanTrouble2E_Bruce_Cocoons.wav","ms":1656,"text":"Cocoons."},{"frame":true,"wav":"OceanTrouble2E_Interesting.wav","ms":1500,"text":"Interesting"},{"frame":false,"wav":"OceanTrouble2E_Bruce_slipping.wav","ms":1500,"text":"They are slipping!"}],"Invisible":[{"frame":false,"wav":"OceanTrouble2E_Bruce_Invisible.wav","ms":1891,"text":"Those fools are invisible!"}],"Fish_Gen":[{"frame":true,"wav":"OceanTrouble2E_Flamethrowers.wav","ms":3234,"text":"It’s getting a bit more difficult. Flamethrowers..."}],"Refuel":[{"frame":true,"wav":"OceanTrouble2E_Alaska.wav","ms":2750,"text":"We’ve got an emergency call from Alaska."},{"frame":false,"wav":"OceanTrouble2E_Bruce_refuel.wav","ms":2594,"text":"Alaska? I have to reful."}]}}
