{"de":{"Home":[{"frame":false,"wav":"OceanTrouble2E_Bruce_surrounded.wav","ms":2125,"text":"Ich bin umgeben von stinkendem Müll."},{"frame":true,"wav":"OceanTrouble2E_homesweethome.wav","ms":1891,"text":"Home sweet home."}],"Door":[{"frame":true,"wav":"OceanTrouble2E_doors.wav","ms":7703,"text":"Die Tür versucht Widerstand zu leisten. Ich hab's... Mist, die nächste Tür hämmert wie verrückt und ich habe keinerlei Kontrolle über sie."}],"Cocoons":[{"frame":false,"wav":"OceanTrouble2E_Bruce_Cocoons.wav","ms":1656,"text":"Kokons."},{"frame":true,"wav":"OceanTrouble2E_Interesting.wav","ms":1500,"text":"Interessant..."},{"frame":false,"wav":"OceanTrouble2E_Bruce_slipping.wav","ms":1500,"text":"Sie schlüpfen!"}],"Invisible":[{"frame":false,"wav":"OceanTrouble2E_Bruce_Invisible.wav","ms":1891,"text":"Diese Viecher sind unsichtbar!"}],"Fish_Gen":[{"frame":true,"wav":"OceanTrouble2E_Flamethrowers.wav","ms":3234,"text":"Schau mal nach oben.. Flammenwerfer!"}],"Refuel":[{"frame":true,"wav":"OceanTrouble2E_Alaska.wav","ms":2750,"text":"Wir haben hier einen Notruf aus Alaska."},{"frame":false,"wav":"OceanTrouble2E_Bruce_refuel.wav","ms":2594,"text":"Alaska? Da muss ich erstmal volltanken."}]},"en":{"Home":[{"frame":false,"wav":"OceanTrouble2E_Bruce_surrounded.wav","ms":2125,"text":"I’m surrounded by dirt."},{"frame":true,"wav":"OceanTrouble2E_homesweethome.wav","ms":1891,"text":"Home sweet home."}],"Door":[{"frame":true,"wav":"OceanTrouble2E_doors.wav","ms":7703,"text":"That door tries to resist. Ah, opened. The next door is hammering and I don’t have any control about it. Be careful."}],"Cocoons":[{"frame":false,"wav":"OceanTrouble2E_Bruce_Cocoons.wav","ms":1656,"text":"Cocoons."},{"frame":true,"wav":"OceanTrouble2E_Interesting.wav","ms":1500,"text":"Interesting"},{"frame":false,"wav":"OceanTrouble2E_Bruce_slipping.wav","ms":1500,"text":"They are slipping!"}],"Invisible":[{"frame":false,"wav":"OceanTrouble2E_Bruce_Invisible.wav","ms":1891,"text":"Those fools are invisible!"}],"Fish_Gen":[{"frame":true,"wav":"OceanTrouble2E_Flamethrowers.wav","ms":3234,"text":"It’s getting a bit more difficult. Flamethrowers..."}],"Refuel":[{"frame":true,"wav":"OceanTrouble2E_Alaska.wav","ms":2750,"text":"We’ve got an emergency call from Alaska."},{"frame":false,"wav":"OceanTrouble2E_Bruce_refuel.wav","ms":2594,"text":"Alaska? I have to reful."}]},"ru":{"Home":[{"frame":false,"wav":"OceanTrouble2RU_Bruce_surrounded.wav","ms":4406,"text":"Я весь окружен воняющими нечистотами."},{"frame":true,"wav":"OceanTrouble2RU_homesweethome.wav","ms":3610,"text":"Эх, дом, милый дом."}],"Door":[{"frame":true,"wav":"OceanTrouble2RU_doors.wav","ms":12390,"text":"Дверь не поддается. О! Открылась! Следующая дверь гремит, но я ни имею ни малейшего понятия, что за ней. Будь осторожен!"}],"Cocoons":[{"frame":false,"wav":"OceanTrouble2RU_Bruce_Cocoons.wav","ms":1235,"text":"Коконы"},{"frame":true,"wav":"OceanTrouble2RU_Interesting.wav","ms":1453,"text":"Интересно"},{"frame":false,"wav":"OceanTrouble2RU_Bruce_slipping.wav","ms":2094,"text":"Они скользкие"}],"Invisible":[{"frame":false,"wav":"OceanTrouble2RU_Bruce_Invisible.wav","ms":1922,"text":"Те чудаки невидимы!"}],"Fish_Gen":[{"frame":true,"wav":"OceanTrouble2RU_Flamethrowers.wav","ms":4531,"text":"Это становиться все более трудным. Огнеметы..."}],"Refuel":[{"frame":true,"wav":"OceanTrouble2RU_Alaska.wav","ms":3109,"text":"Мы получили  срочный запрос из Аляски."},{"frame":false,"wav":"OceanTrouble2RU_Bruce_refuel.wav","ms":3781,"text":"Из Аляски?  Я должен заправиться горючим."}]}}
