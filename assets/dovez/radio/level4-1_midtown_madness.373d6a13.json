{"de":{"MidtownCity":[{"frame":true,"wav":"MidtownCity1E_Midtown.wav","ms":2750,"text":"Wir sind da. Midtown City..."},{"frame":false,"wav":"MidtownCity1E_Bruce_Dogfight.wav","ms":4547,"text":"Yeehaw, kommt zu Papi, ich mach euch fertig!"}],"Incoming":[{"frame":true,"wav":"MidtownCity1E_Incoming.wav","ms":1735,"text":"Feindliche Bomber gesichtet."},{"frame":false,"wav":"MidtownCity1E_Bruce_wantsome.wav","ms":1578,"text":"Wer will als erstes..?"}],"Holyshit":[{"frame":false,"wav":"MidtownCity1E_Bruce_Holyshit.wav","ms":2203,"text":"Verflixt, sie sind überall."}],"Underalien":[{"frame":true,"wav":"MidtownCity1E_Underalien.wav","ms":4719,"text":"Die Stadt ist gänzlich unter feindlichem Beschuss. Alle Einwohner wurden evakuiert. Ich brauch nen Kaffee."}],"Sun":[{"frame":false,"wav":"MidtownCity1E_Bruce_sun.wav","ms":3062,"text":"Die Sonne geht unter - siehst du das?"},{"frame":true,"wav":"MidtownCity1E_nowayout.wav","ms":2281,"text":"Oh ja - aber es gibt keinen Ausweg."}]},"en":{"MidtownCity":[{"frame":true,"wav":"MidtownCity1E_Midtown.wav","ms":2750,"text":"Here we are. Midtown City."},{"frame":false,"wav":"MidtownCity1E_Bruce_Dogfight.wav","ms":4547,"text":"Yeehaw, big daddy is on the road. Time for some dogfights!"}],"Incoming":[{"frame":true,"wav":"MidtownCity1E_Incoming.wav","ms":1735,"text":"Incoming bombers."},{"frame":false,"wav":"MidtownCity1E_Bruce_wantsome.wav","ms":1578,"text":"Who wants some?"}],"Holyshit":[{"frame":false,"wav":"MidtownCity1E_Bruce_Holyshit.wav","ms":2203,"text":"Holy shit, they are everywhere."}],"Underalien":[{"frame":true,"wav":"MidtownCity1E_Underalien.wav","ms":4719,"text":"The city is completely under alien attack. All people had been evacuated."}],"Sun":[{"frame":false,"wav":"MidtownCity1E_Bruce_sun.wav","ms":3062,"text":"The sun has gone down. Did you see that?"},{"frame":true,"wav":"MidtownCity1E_nowayout.wav","ms":2281,"text":"Yeah, but there is no way out."}]},"ru":{"MidtownCity":[{"frame":true,"wav":"MidtownCity1RU_Midtown.wav","ms":2704,"text":"Центр города. Мы здесь."},{"frame":false,"wav":"MidtownCity1RU_Bruce_Dogfight.wav","ms":4156,"text":"Большой папа в дороге. Время воздушных потасовок."}],"Incoming":[{"frame":true,"wav":"MidtownCity1RU_Incoming.wav","ms":2125,"text":"Бомбардировщики атакуют."},{"frame":false,"wav":"MidtownCity1RU_Bruce_wantsome.wav","ms":2047,"text":"Кто еще хочет немного?"}],"Holyshit":[{"frame":false,"wav":"MidtownCity1RU_Bruce_Holyshit.wav","ms":2281,"text":"О черт, они по всюду."}],"Underalien":[{"frame":true,"wav":"MidtownCity1RU_Underalien.wav","ms":5266,"text":"Город полностью атакован пришельцами. Все люди эвакуированы."}],"Sun":[{"frame":false,"wav":"MidtownCity1RU_Bruce_sun.wav","ms":2828,"text":"Солнце спускается. Ты видишь это?"},{"frame":true,"wav":"MidtownCity1RU_nowayout.wav","ms":3062,"text":"Ндаа. Но выхода нет."}]}}
