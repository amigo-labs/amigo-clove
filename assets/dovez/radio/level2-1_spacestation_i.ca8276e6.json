{"de":{"On my way":[{"frame":true,"wav":"Spacestation1E_takecare.wav","ms":2508,"text":"Die Space Station braucht Unterstützung."},{"frame":false,"wav":"Spacestation1E_Bruce_onmyway.wav","ms":1640,"text":"Bin schon auf dem Weg."}],"Going in":[{"frame":false,"wav":"Spacestation1E_Bruce_goingin.wav","ms":2500,"text":"Okay, ich flieg rein."},{"frame":true,"wav":"Spacestation1E_outacontrol.wav","ms":7227,"text":"Verdammt alle Docks sind verschlossen oder außer Kontrolle. Ich hacke mich ins Hauptsystem und versuche das in den Griff zu bekommen."}],"Door1":[{"frame":false,"wav":"Spacestation1E_Bruce_locked.wav","ms":2600,"text":"Verschlossen..."},{"frame":true,"wav":"Spacestation1E_door1.wav","ms":4046,"text":"Gib mir eine Sekunde. Drei - Zwei - Eins. Bingo!"}],"Impressive":[{"frame":false,"wav":"Spacestation1E_Bruce_impressive.wav","ms":1321,"text":"Beeindruckend"},{"frame":true,"wav":"Spacestation1E_noprob.wav","ms":2212,"text":"Kein Problem."}],"Open Doors":[{"frame":true,"wav":"Spacestation1E_fishy.wav","ms":4412,"text":"Werf ein Auge auf die Schleusen vor dir. Das ist ein wenig eigenartig."}],"Door 2":[{"frame":false,"wav":"Spacestation1E_Bruce_Jones.wav","ms":1500,"text":"Jones?"},{"frame":true,"wav":"Spacestation1E_door2.wav","ms":4394,"text":"Ah ‘tschuldige. Ich brauchte ‘nen frischen Kaffee. Sesam öffne dich!"}]},"en":{"On my way":[{"frame":true,"wav":"Spacestation1E_takecare.wav","ms":2508,"text":"The space station needs assistance"},{"frame":false,"wav":"Spacestation1E_Bruce_onmyway.wav","ms":1640,"text":"On my way."}],"Going in":[{"frame":false,"wav":"Spacestation1E_Bruce_goingin.wav","ms":2500,"text":"Okay, I’m going in."},{"frame":true,"wav":"Spacestation1E_outacontrol.wav","ms":7227,"text":"Damn, all doors are locked or simply outa control. I’m going to hack myself into the main system and try to handle this."}],"Door1":[{"frame":false,"wav":"Spacestation1E_Bruce_locked.wav","ms":2600,"text":"Locked."},{"frame":true,"wav":"Spacestation1E_door1.wav","ms":404