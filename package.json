{
  "name": "amigo-clove",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "assets:build": "bun packages/assetkit/src/cli.ts build",
    "assets:check": "bun packages/assetkit/src/cli.ts check",
    "assets:verify": "bun packages/assetkit/src/cli.ts verify",
    "assets:report": "bun packages/assetkit/src/cli.ts report",
    "smoke": "bun run --cwd packages/shell smoke"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.11"
}
